# Copier en .env.local (développement) ou renseigner dans Vercel
# (Project → Settings → Environment Variables). Ne jamais committer .env.local.

# --- Formulaire de contact : envoi par e-mail (prioritaire) ------------------
# Clé API Resend (https://resend.com → API Keys). Sans elle, pas d'e-mail.
RESEND_API_KEY=
# Destinataire des demandes (défaut : contact@stipway.com).
CONTACT_EMAIL_TO=contact@stipway.com
# Expéditeur. Par défaut « onboarding@resend.dev », qui n'envoie QU'À l'adresse
# du compte Resend. Une fois le domaine vérifié dans Resend, utiliser par ex. :
# CONTACT_EMAIL_FROM="STAR DIGI PRO <site@stardigipro.com>"
CONTACT_EMAIL_FROM=

# --- Alternative : webhook (Make, n8n, CRM…) -------------------------------
# Utilisé seulement si RESEND_API_KEY est vide.
CONTACT_WEBHOOK_URL=

# --- Analytics (aucun script installé tant que les vrais ID manquent) -------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
